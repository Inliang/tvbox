# jmgo-patch v1
# id: P002
# why: leanback flavor 的 BootReceiver 在 BOOT_COMPLETED / QUICKBOOT_POWERON 时注册网络回调
#      并执行 LiveConfig.init().load()，是开机即常驻的爬虫/配置加载入口；DLNARendererService
#      属于投屏接收，SPEC 明确不在交付范围。两者在 3GB 设备上都是纯占用。
# target: app/src/leanback/AndroidManifest.xml
@@
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:priority="999">
--- NEW
        <!-- JMGO: 开机广播会在后台触发 LiveConfig 加载并注册网络回调，3GB 设备上属于无需的常驻入口。 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="false"
            android:exported="true"
            android:priority="999">
@@
        <service
            android:name=".service.DLNARendererService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
--- NEW
        <!-- JMGO: DLNA 接收端不在交付范围内，禁用以降低后台服务占用。 -->
        <service
            android:name=".service.DLNARendererService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
