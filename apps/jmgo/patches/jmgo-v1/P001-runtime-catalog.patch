# jmgo-patch v1
# id: P001
# why: 5.8.7 把 python/nodejs/quickjs/thunder/mpv/bdj 拆成独立 runtime 模块，
#      catalog.json 默认硬编码指向 GitHub Release。国内网络拉不到清单时首页可用、
#      一点播放就崩。改成三级解析，让 CI 能注入可达镜像或本仓库 Release 资产地址。
# target: app/build.gradle
@@
        manifestPlaceholders.runtimeCatalog = providers.gradleProperty('tvRuntimeCatalog').getOrElse('https://github.com/FongMi/Release/releases/download/module/catalog.json')
--- NEW
        // JMGO: catalog 地址按 gradle property > 环境变量 > 上游默认 三级解析。
        // CI 通过 -PtvRuntimeCatalog 或 JMGO_CATALOG_URL 注入可达镜像；未配置时保持官方地址。
        // 不把第三方代理域名硬编码进 APK：代理可用性无法保证，由使用者按网络环境配置。
        manifestPlaceholders.runtimeCatalog = providers.gradleProperty('tvRuntimeCatalog')
                .orElse(providers.environmentVariable('JMGO_CATALOG_URL'))
                .getOrElse('https://github.com/FongMi/Release/releases/download/module/catalog.json')
