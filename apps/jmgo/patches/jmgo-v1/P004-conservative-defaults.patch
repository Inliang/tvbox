# jmgo-patch v1
# id: P004
# why: 3GB RAM 设备上把首次启动默认档位调保守，减少音频透传、字幕渲染、后台播放、
#      预加载和自动更新任务同时驻留。全部是一行式默认值替换，不改方法签名与控制流。
#      解码模式保持 DecoderMode.AUTO（上游已是最保守的自动选择），不强制软解/硬解。
#      清晰度由上游播放页的线路列表决定，没有全局默认项可改；用户侧一次性设置见 README。
# target: app/src/main/java/com/fongmi/android/tv/setting/DecodeSetting.java
@@
        return Prefers.getBoolean("decode_audio_pass_through", Prefers.getBoolean("audio_pass_through", true));
--- NEW
        return Prefers.getBoolean("decode_audio_pass_through", Prefers.getBoolean("audio_pass_through", false));
# target: app/src/main/java/com/fongmi/android/tv/setting/PlayerSetting.java
@@
        return Prefers.getBoolean("player_libass", true);
--- NEW
        return Prefers.getBoolean("player_libass", false);
@@
        return Math.clamp(Prefers.getInt("background", 2), MIN_BACKGROUND, MAX_BACKGROUND);
--- NEW
        return Math.clamp(Prefers.getInt("background", 0), MIN_BACKGROUND, MAX_BACKGROUND);
# target: app/src/main/java/com/fongmi/android/tv/setting/PreloadSetting.java
@@
        int seconds = Math.clamp(Prefers.getInt("preload_time", MAX_TIME_SECONDS), MIN_TIME_SECONDS, MAX_TIME_SECONDS);
--- NEW
        int seconds = Math.clamp(Prefers.getInt("preload_time", MIN_TIME_SECONDS), MIN_TIME_SECONDS, MAX_TIME_SECONDS);
# target: app/src/main/java/com/fongmi/android/tv/setting/Setting.java
@@
        return Prefers.getBoolean("update", true);
--- NEW
        return Prefers.getBoolean("update", false);
